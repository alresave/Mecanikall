{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "mecanikall": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "logo.png", "input": ".", "output": "/" },
              { "glob": "manifest.webmanifest", "input": ".", "output": "/" },
              { "glob": "**/*", "input": "src/assets", "output": "/assets/" }
            ],
            "serviceWorker": "ngsw-config.json",
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" }],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "mecanikall:build:production" },
            "development": { "buildTarget": "mecanikall:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": { "builder": "@angular/build:karma", "options": { "tsConfig": "tsconfig.spec.json", "assets": [], "styles": ["src/styles.css"] } }
      }
    }
  },
  "cli": {
    "analytics": "fd52056f-ee0c-4640-a225-cf4a3892e566"
  }
}
